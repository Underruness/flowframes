<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same style name as the historical edition (the manifest refers to it); Capri draws its own
         Material You surface on top, and starts from the night colour so the launch does not flash
         white. -->
    <style name="Theme.FlowFrames" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0A14</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
