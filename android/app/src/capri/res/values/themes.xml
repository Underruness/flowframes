<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same style name as the historical edition (the manifest refers to it); Capri draws its own
         surface on top, and starts from the character's black so the launch does not flash white. -->
    <style name="Theme.FlowFrames" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#08060C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
