# Android / Gradle
build/
.gradle/
local.properties
*.iml
.idea/
.kotlin/
captures/
.cxx/

# Signing secrets - never commit
keystore.properties
app/keystore/*.jks
app/keystore/*.keystore

# ncnn prebuilt, downloaded by app/src/main/cpp/CMakeLists.txt
app/src/main/cpp/ncnn-android
app/src/main/cpp/ncnn-*-android-vulkan.zip

# ncnn RIFE weights (the root .gitignore drops every *.bin)
!app/src/main/assets/ncnn/**/flownet.bin
